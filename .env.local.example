# Copy to .env.local and fill in real values. Never commit .env.local.

# Deployed PayrollManager address (set after deploy)
NEXT_PUBLIC_MAINNET_PAYROLL_ADDRESS=0x...
# Optional but recommended for complete control-room history scans.
ARC_PAYROLL_DEPLOYMENT_BLOCK=123456

# Wallet auth (Privy) — https://dashboard.privy.io
# App ID is public (shipped to the browser). App secret is SERVER-ONLY.
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# Neon Postgres — https://console.neon.tech — SERVER-ONLY, never expose client-side
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Resend transactional email (OPTIONAL). https://resend.com  SERVER-ONLY.
# When set, Cadence emails users about account activity (sign-in, welcome,
# payments started, requests, counters, receipts) to whatever email is linked
# to their account. When unset, all email is silently skipped and the app works
# exactly as before. The sender domain must be verified in Resend first.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Cadence <hello@cadenceonarc.tech>
