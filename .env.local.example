# Copy to .env.local and fill in real values. Never commit .env.local.

# Deployed PayrollManager address (set after deploy)
NEXT_PUBLIC_PAYROLL_ADDRESS=0x...
# Optional legacy deployment. Existing streams remain readable/actionable
# while a non-upgradeable PayrollManager is migrated manually.
NEXT_PUBLIC_LEGACY_PAYROLL_ADDRESS=0x...

# Wallet auth (Privy) — https://dashboard.privy.io
# App ID is public (shipped to the browser). App secret is SERVER-ONLY.
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# Neon Postgres — https://console.neon.tech — SERVER-ONLY, never expose client-side
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Circle faucet (OPTIONAL) — https://console.circle.com — SERVER-ONLY.
# When set, the "Get testnet USDC" button drips Arc Testnet USDC to the
# connected wallet in one click via Circle's /v1/faucet/drips API. When unset
# (or Circle declines — the drips API requires a mainnet-upgraded account), the
# button falls back to opening the public faucet (faucet.circle.com) with the
# address ready to paste. Sandbox keys are prefixed "TEST_API_KEY:".
CIRCLE_API_KEY=TEST_API_KEY:your_circle_api_key

# Resend transactional email (OPTIONAL). https://resend.com  SERVER-ONLY.
# When set, Cadence emails users about account activity (sign-in, welcome,
# payments started, requests, counters, receipts) to whatever email is linked
# to their account. When unset, all email is silently skipped and the app works
# exactly as before. The sender domain must be verified in Resend first.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Cadence <hello@cadenceonarc.tech>
