# Copy to .env.local and fill in real values. Never commit .env.local.

# Deployed PayrollManager address (set after deploy)
NEXT_PUBLIC_PAYROLL_ADDRESS=0x...

# Wallet auth (Privy) — https://dashboard.privy.io
# App ID is public (shipped to the browser). App secret is SERVER-ONLY.
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# Neon Postgres — https://console.neon.tech — SERVER-ONLY, never expose client-side
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
